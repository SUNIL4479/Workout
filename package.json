{
  "name": "fitifi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c yellow,cyan \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "start:app": "npm run start --prefix App",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run build --workspace frontend",
    "build:backend": "npm run build --workspace backend",
    "start": "npm run start --workspace backend",
    "lint": "tsc --noEmit",
    "clean": "rimraf frontend/dist backend/dist"
  },
  "devDependencies": {
    "@expo/cli": "^57.0.14",
    "concurrently": "^9.1.2",
    "rimraf": "^6.0.1",
    "typescript": "~5.8.2"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "exceljs": "^4.4.0",
    "expo": "^57.0.12",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-speech": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  }
}
