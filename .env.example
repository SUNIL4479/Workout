# --- Backend environment variables ---
# Set these on Render (or Vercel if deploying backend there).

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MONGODB_URI: MongoDB connection string used for user accounts and leaderboard.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/"

# SESSION_SECRET: Secret used to sign the stateless auth cookie. Use a long random string.
SESSION_SECRET="MY_RANDOM_SESSION_SECRET"

# APP_URL: The deployed frontend URL. Used by CORS to allow requests from this origin.
APP_URL="https://workout-frontend-smoky.vercel.app"

# --- Frontend environment variables ---
# VITE_ vars are baked into the build at compile time by Vite.
# Set these on Vercel under Frontend Project → Settings → Environment Variables.

# VITE_API_BASE_URL: Absolute URL of the backend API (no trailing slash after /api).
VITE_API_BASE_URL="https://workout-ced4.onrender.com/api"

