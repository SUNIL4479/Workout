# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this in Vercel Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MONGODB_URI: MongoDB connection string used for user accounts and leaderboard.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DATABASE"

# SESSION_SECRET: Secret used to sign the stateless auth cookie. Use a long random string.
SESSION_SECRET="MY_RANDOM_SESSION_SECRET"

# APP_URL: Local frontend URL during development.
APP_URL="http://localhost:5173"

# VITE_API_BASE_URL: Local backend API URL during development.
VITE_API_BASE_URL="/api"
